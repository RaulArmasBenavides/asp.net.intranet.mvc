@model intranetMVC.Models.Academico.DashboardViewModel
@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">

    @* ── Banner de bienvenida ── *@
    <div class="card border-0 bg-primary text-white shadow mb-4">
        <div class="card-body py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold">Bienvenido, @Model.NombreAlumno</h5>
                <small class="opacity-75">Código: @Model.CodigoAlumno &nbsp;|&nbsp; Período: @Model.Periodo &nbsp;|&nbsp;
                    <span class="badge bg-white text-primary">@Model.Estado</span>
                </small>
            </div>
            <i class="fas fa-university fa-2x opacity-50"></i>
        </div>
    </div>

    @* ── Stats ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-primary">@Model.Promedio.ToString("F2")</div>
                <div class="text-muted small"><i class="fas fa-star me-1"></i>Promedio General</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-success">@Model.CreditosAprobados</div>
                <div class="text-muted small"><i class="fas fa-layer-group me-1"></i>Créditos Aprobados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-info">@Model.CicloActual°</div>
                <div class="text-muted small"><i class="fas fa-calendar me-1"></i>Ciclo Actual</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-warning">@Model.CursosMatriculados</div>
                <div class="text-muted small"><i class="fas fa-book me-1"></i>Cursos Matriculados</div>
            </div>
        </div>
    </div>

    <div class="row g-3">

        @* ── Clases de hoy ── *@
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-semibold py-2">
                    <i class="fas fa-clock me-1 text-primary"></i>Clases de Hoy
                </div>
                <div class="card-body p-0">
                    @if (Model.HoyClases != null && Model.HoyClases.Count > 0)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var c in Model.HoyClases)
                            {
                                <li class="list-group-item d-flex align-items-center gap-3">
                                    <span class="badge @c.ColorClass rounded-pill" style="width:12px;height:40px">&nbsp;</span>
                                    <div>
                                        <div class="fw-semibold small">@c.Codigo — @c.Nombre</div>
                                        <div class="text-muted" style="font-size:.75rem">
                                            <i class="fas fa-clock me-1"></i>@c.HoraInicio – @c.HoraFin
                                            &nbsp;<i class="fas fa-door-open ms-1 me-1"></i>@c.Aula
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-coffee fa-2x mb-2 d-block"></i>
                            No tienes clases hoy
                        </div>
                    }
                </div>
                <div class="card-footer bg-white text-end">
                    <a href="/Alumno/Horario" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-calendar-week me-1"></i>Ver horario completo
                    </a>
                </div>
            </div>
        </div>

        @* ── Anuncios ── *@
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-semibold py-2">
                    <i class="fas fa-bullhorn me-1 text-danger"></i>Anuncios y Avisos
                </div>
                <div class="card-body p-2">
                    @foreach (var a in Model.Anuncios)
                    {
                        <div class="alert alert-@a.Tipo alert-dismissible py-2 mb-2" role="alert">
                            <div class="d-flex justify-content-between">
                                <strong><i class="fas fa-circle-info me-1"></i>@a.Titulo</strong>
                                <small class="text-muted">@a.Fecha</small>
                            </div>
                            <div class="small mt-1">@a.Descripcion</div>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    @* ── Accesos rápidos ── *@
    <div class="row g-3 mt-1">
        @{ var links = new[] {
            new { Href="/Alumno/Perfil",         Icon="fa-user",           Label="Mi Perfil",       Color="primary" },
            new { Href="/Alumno/Historial",       Icon="fa-graduation-cap", Label="Historial",        Color="success" },
            new { Href="/Matricula/Index",        Icon="fa-pencil-alt",     Label="Matrícula",        Color="warning" },
            new { Href="/Alumno/Horario",         Icon="fa-calendar-week",  Label="Horario",          Color="info"    },
            new { Href="/Asistencia/Index",       Icon="fa-clipboard-check",Label="Asistencias",      Color="danger"  },
            new { Href="/ReportePreMatricula/Index",Icon="fa-file-alt",     Label="Reportes",         Color="secondary"},
        }; }
        @foreach (var l in links)
        {
            <div class="col-6 col-md-2">
                <a href="@l.Href" class="card border-0 shadow-sm text-center py-3 text-decoration-none text-@l.Color d-block">
                    <i class="fas @l.Icon fa-lg mb-1"></i>
                    <div class="small fw-semibold">@l.Label</div>
                </a>
            </div>
        }
    </div>

</div>
