@model intranetMVC.Models.Academico.PerfilViewModel
@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var partes   = Model.NombreCompleto.Split(',');
    var iniciales = ((partes.Length > 1 ? partes[1].Trim() : "").FirstOrDefault().ToString()
                  + partes[0].Trim().FirstOrDefault().ToString()).ToUpper();
}

@helper Campo(string label, string valor)
{
    <div class="col-md-6">
        <label class="text-muted fw-semibold text-uppercase" style="font-size:.72rem">@label</label>
        <div class="fw-semibold border-bottom pb-1">@valor</div>
    </div>
}

<div class="container-fluid px-0">

    <h4 class="fw-bold mb-4"><i class="fas fa-user-circle me-2 text-primary"></i>Mi Perfil</h4>

    <div class="row g-4">

        @* Columna izquierda — avatar + stats *@
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold"
                     style="width:90px;height:90px;font-size:2rem">
                    @iniciales
                </div>
                <h6 class="fw-bold mb-0 text-uppercase">@Model.NombreCompleto</h6>
                <small class="text-muted">@Model.CodigoAlumno</small>
                <hr />
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="fw-bold text-primary fs-5">@Model.Promedio.ToString("F2")</div>
                        <div class="text-muted" style="font-size:.7rem">Promedio</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-success fs-5">@Model.CreditosAprobados</div>
                        <div class="text-muted" style="font-size:.7rem">Créditos</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-info fs-5">@Model.CicloActual°</div>
                        <div class="text-muted" style="font-size:.7rem">Ciclo</div>
                    </div>
                </div>
                <hr />
                <span class="badge @(Model.Estado == "Regular" ? "bg-success" : "bg-warning text-dark") w-100 py-2 fs-6">
                    @Model.Estado
                </span>
                <div class="mt-2 small text-muted">Turno: <strong>@Model.Turno</strong></div>
            </div>
        </div>

        @* Columna derecha — tabs *@
        <div class="col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white pt-3 pb-0">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#tab-personal">
                                <i class="fas fa-id-card me-1"></i>Datos Personales
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#tab-academico">
                                <i class="fas fa-university me-1"></i>Info Académica
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#tab-contacto">
                                <i class="fas fa-map-marker-alt me-1"></i>Contacto
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body tab-content p-4">

                    <div class="tab-pane fade show active" id="tab-personal">
                        <div class="row g-3">
                            @Campo("Nombre Completo",     Model.NombreCompleto)
                            @Campo("DNI",                  Model.DNI)
                            @Campo("Fecha de Nacimiento",  Model.FechaNacimiento)
                            @Campo("Sexo",                 Model.Sexo)
                            @Campo("Correo Institucional", Model.Email)
                            @Campo("Teléfono",             Model.Telefono)
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-academico">
                        <div class="row g-3">
                            @Campo("Código de Alumno",    Model.CodigoAlumno)
                            @Campo("Facultad",             Model.Facultad)
                            @Campo("Carrera Profesional",  Model.Carrera)
                            @Campo("Modalidad",            Model.Modalidad)
                            @Campo("Año de Ingreso",       Model.AnioIngreso)
                            @Campo("Ciclo Actual",         Model.CicloActual + "° Ciclo")
                            @Campo("Estado Académico",     Model.Estado)
                            @Campo("Tutor Asignado",       Model.Tutor)
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-contacto">
                        <div class="row g-3">
                            @Campo("Dirección",    Model.Direccion)
                            @Campo("Distrito",     Model.Distrito)
                            @Campo("Provincia",    Model.Provincia)
                            @Campo("Departamento", Model.Departamento)
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
