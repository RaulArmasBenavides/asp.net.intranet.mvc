@model intranetMVC.Models.Academico.PerfilViewModel
@{
    ViewBag.Title = "Datos Personales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fas fa-id-card me-2 text-primary"></i>Datos Personales</h4>
        <span class="badge bg-light text-dark border">Código: <strong>@Model.CodigoAlumno</strong></span>
    </div>

    @* ── Sección: Información Personal ── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white py-2">
            <i class="fas fa-user me-2"></i>Información Personal
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small fw-semibold">APELLIDOS Y NOMBRES</label>
                    <div class="form-control-plaintext fw-bold border-bottom">@Model.NombreCompleto</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-semibold">DNI</label>
                    <div class="form-control-plaintext border-bottom">@Model.DNI</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-semibold">FECHA DE NACIMIENTO</label>
                    <div class="form-control-plaintext border-bottom">@Model.FechaNacimiento</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-semibold">SEXO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Sexo</div>
                </div>
                <div class="col-md-5">
                    <label class="text-muted small fw-semibold">CORREO INSTITUCIONAL</label>
                    <div class="form-control-plaintext border-bottom">@Model.Email</div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted small fw-semibold">TELÉFONO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Telefono</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Sección: Domicilio ── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-secondary text-white py-2">
            <i class="fas fa-home me-2"></i>Domicilio
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small fw-semibold">DIRECCIÓN</label>
                    <div class="form-control-plaintext border-bottom">@Model.Direccion</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">DISTRITO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Distrito</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">PROVINCIA</label>
                    <div class="form-control-plaintext border-bottom">@Model.Provincia</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">DEPARTAMENTO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Departamento</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Sección: Información Académica ── *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-info text-white py-2">
            <i class="fas fa-graduation-cap me-2"></i>Información Académica
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="text-muted small fw-semibold">FACULTAD</label>
                    <div class="form-control-plaintext border-bottom">@Model.Facultad</div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted small fw-semibold">CARRERA PROFESIONAL</label>
                    <div class="form-control-plaintext border-bottom">@Model.Carrera</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">AÑO DE INGRESO</label>
                    <div class="form-control-plaintext border-bottom">@Model.AnioIngreso</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">CICLO ACTUAL</label>
                    <div class="form-control-plaintext border-bottom">@Model.CicloActual° Ciclo</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">MODALIDAD</label>
                    <div class="form-control-plaintext border-bottom">@Model.Modalidad</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">TURNO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Turno</div>
                </div>
                <div class="col-md-2">
                    <label class="text-muted small fw-semibold">ESTADO</label>
                    <div class="form-control-plaintext border-bottom">
                        <span class="badge @(Model.Estado == "Regular" ? "bg-success" : "bg-warning text-dark")">@Model.Estado</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small fw-semibold">TUTOR ASIGNADO</label>
                    <div class="form-control-plaintext border-bottom">@Model.Tutor</div>
                </div>
            </div>
        </div>
    </div>

</div>
