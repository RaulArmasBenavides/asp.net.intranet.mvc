@model intranetMVC.Models.Academico.ReporteDeudasViewModel
@{
    ViewBag.Title = "Estado de Deudas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0"><i class="fas fa-file-invoice-dollar me-2 text-warning"></i>Estado de Deudas</h4>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="fas fa-print me-1"></i>Imprimir
        </button>
    </div>

    @* Resumen *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 bg-success text-white shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="small opacity-75">Pagado</div>
                        <div class="fs-4 fw-bold">
                            S/. @Model.Deudas.Where(d => d.Estado == "Pagado").Sum(d => d.Monto).ToString("F2")
                        </div>
                    </div>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-warning text-dark shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="small opacity-75">Pendiente</div>
                        <div class="fs-4 fw-bold">
                            S/. @Model.Deudas.Where(d => d.Estado == "Pendiente").Sum(d => d.Monto).ToString("F2")
                        </div>
                    </div>
                    <i class="fas fa-clock fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-danger text-white shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="small opacity-75">Vencido</div>
                        <div class="fs-4 fw-bold">
                            S/. @Model.Deudas.Where(d => d.Estado == "Vencido").Sum(d => d.Monto).ToString("F2")
                        </div>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalPendiente > 0)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3 py-2">
            <span><i class="fas fa-exclamation-circle me-1"></i>Tienes obligaciones pendientes por un total de</span>
            <strong class="fs-5">S/. @Model.TotalPendiente.ToString("F2")</strong>
        </div>
    }

    @* Tabla de deudas *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Concepto</th>
                        <th class="text-end">Monto</th>
                        <th class="text-center">Vencimiento</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Deudas)
                    {
                        var rowClass = d.Estado == "Vencido" ? "table-danger" : d.Estado == "Pendiente" ? "table-warning" : "";
                        <tr class="@rowClass">
                            <td class="fw-semibold">@d.Concepto</td>
                            <td class="text-end fw-bold">S/. @d.Monto.ToString("F2")</td>
                            <td class="text-center">@d.FechaVencimiento</td>
                            <td class="text-center">
                                @if (d.Estado == "Pagado")
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Pagado</span>
                                }
                                else if (d.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-exclamation me-1"></i>Vencido</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (d.Estado != "Pagado")
                                {
                                    <button class="btn btn-sm btn-primary py-0 px-2"
                                            onclick="mostrarError('Los pagos se realizan en Tesorería de la Facultad.')">
                                        <i class="fas fa-credit-card me-1"></i>Pagar
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
