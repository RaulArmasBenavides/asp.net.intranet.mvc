@model intranetMVC.Models.Academico.ReportePreMatriculaViewModel
@{
    ViewBag.Title = "Pre-Matrícula";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var habilitados   = Model.Cursos.Count(c => c.HabilitadoPrereq);
    var totalCreditos = Model.Cursos.Where(c => c.HabilitadoPrereq).Sum(c => c.Creditos);
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0"><i class="fas fa-calendar-check me-2 text-info"></i>Pre-Matrícula</h4>
            <small class="text-muted">Período siguiente: <strong>@Model.Periodo</strong></small>
        </div>
        <span class="badge bg-info fs-6 px-3">
            Ciclo @Model.CicloActual → @Model.CicloSiguiente
        </span>
    </div>

    @* Resumen *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-info">@Model.Cursos.Count</div>
                <div class="text-muted small">Cursos del Ciclo @Model.CicloSiguiente</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-success">@habilitados</div>
                <div class="text-muted small">Habilitados (prerequisitos OK)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-primary">@totalCreditos</div>
                <div class="text-muted small">Créditos disponibles</div>
            </div>
        </div>
    </div>

    @* Tabla de cursos *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold py-2">
            <i class="fas fa-list me-1 text-info"></i>Cursos para el Ciclo @Model.CicloSiguiente
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nombre del Curso</th>
                        <th class="text-center">Créditos</th>
                        <th class="text-center">Prerequisito</th>
                        <th class="text-center">Habilitado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cursos)
                    {
                        <tr class="@(!c.HabilitadoPrereq ? "table-secondary text-muted" : "")">
                            <td class="font-monospace fw-semibold @(c.HabilitadoPrereq ? "text-primary" : "text-muted")">
                                @c.Codigo
                            </td>
                            <td class="fw-semibold">@c.Nombre</td>
                            <td class="text-center"><span class="badge bg-secondary">@c.Creditos</span></td>
                            <td class="text-center">
                                <span class="font-monospace small">@c.Prerequisito</span>
                            </td>
                            <td class="text-center">
                                @if (c.HabilitadoPrereq)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Habilitado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i>Prerequisito pendiente</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2">
            <i class="fas fa-info-circle me-1 text-info"></i>
            Los cursos en gris requieren que apruebes el prerequisito antes de poder matricularte.
            La matrícula oficial se realiza desde el módulo <a href="/Matricula/Index">Matrícula de Cursos</a>.
        </div>
    </div>

</div>
